# Copy to .env only on your private host. Never commit real values.
BUILD_COMMIT=development
FIELDPLAY_DOMAIN=fieldplay.example.invalid
ALLOWED_ORIGINS=https://fieldplay.example.invalid
ICE_SERVERS=[]
# Optional: own STUN URLs may be declared in ICE_SERVERS. No proprietary defaults.
# For TURN, create a random shared secret and configure the same secret in coturn.
TURN_URLS=
TURN_SECRET=
TURN_EXTERNAL_IP=127.0.0.1
# Optional build-time HTTPS release manifest for this private distribution.
EXPO_PUBLIC_UPDATE_MANIFEST=

# Expo compile-time settings for hosted builds (public configuration, not secrets).
EXPO_PUBLIC_FIELDPLAY_PRODUCTION=1
EXPO_PUBLIC_SIGNAL_URL=wss://fieldplay.xcenter.it
