{
  "name": "fieldplay-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run start -w @fieldplay/mobile",
    "server": "tsx services/server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/browser-test.ts",
    "web:build": "npm run web:build -w @fieldplay/mobile",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
